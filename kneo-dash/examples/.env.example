# Kneo Agent Dashboard — example environment.
# Copy to `.env`, fill in the real values, and pass with `--env-file .env`.
# The BFF reads dashboard settings under the KNEO_DASH_ prefix; the platform
# connection (KNEO_URL/KNEO_API_KEY/KNEO_PROFILE) is read by kneo_client.

# ── Platform connection (required) ─────────────────────────────────────────
# The kneo-serv this dashboard operates. The API key is a per-environment
# service account; the BFF authorizes each operator BEFORE calling /v1.
KNEO_URL=https://kneo-serv.internal
KNEO_API_KEY=change-me-service-account-key
# Alternatively use a named kneo_client profile instead of URL/KEY:
# KNEO_PROFILE=prod

# ── Auth ────────────────────────────────────────────────────────────────────
# Production: OIDC (Authorization Code + PKCE), roles enforced server-side.
KNEO_DASH_AUTH_MODE=oidc
# 32+ char random secret — keys the session HMAC + the OIDC handshake cookie.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
KNEO_DASH_SESSION_SECRET=change-me-to-a-strong-32plus-char-secret
KNEO_DASH_OIDC_ISSUER=https://idp.example.com/realms/kneo
KNEO_DASH_OIDC_CLIENT_ID=kneo-dash
KNEO_DASH_OIDC_CLIENT_SECRET=change-me
KNEO_DASH_OIDC_REDIRECT_URL=https://dash.example.com/api/callback
# IdP claim carrying the operator's groups/roles (default: "roles").
# KNEO_DASH_OIDC_ROLE_CLAIM=roles
# Map IdP group → dashboard role (viewer|operator|admin), as JSON.
KNEO_DASH_OIDC_ROLE_MAP={"kneo-admins":"admin","kneo-ops":"operator","kneo-viewers":"viewer"}
# Optional: bootstrap this subject/email as admin on first login.
# KNEO_DASH_OIDC_BOOTSTRAP_ADMIN=you@example.com
#
# Dev/eval ONLY — a single UNAUTHENTICATED admin (no login). The app refuses to
# start in static mode without DEV_MODE=1. Never use in production.
# KNEO_DASH_AUTH_MODE=static
# KNEO_DASH_DEV_MODE=1

# ── Dashboard-local state store (ADR-006) ────────────────────────────────────
# SUPPORTED topology = single-instance **SQLite** (ADR-012). docker-compose.prod.yml
# mounts a volume at /var/lib/kneo-dash and the image already defaults KNEO_DASH_DB_URL
# to the SQLite file there — so you normally leave this UNSET for prod.
# KNEO_DASH_DB_URL=sqlite:////var/lib/kneo-dash/state.db
#
# Postgres (multi-replica/HA) is **best-effort, NOT certified** and needs an image built
# with the [postgres] extra (the published image ships base-only) — see
# docker-compose.prod-postgres.yml. Then:
# KNEO_DASH_DB_URL=postgresql://kneo:change-me@db:5432/kneo_dash
# POSTGRES_PASSWORD=change-me

# ── Optional ─────────────────────────────────────────────────────────────────
# Deep-link to your Grafana for the metrics tiles (ADR-005).
# KNEO_DASH_GRAFANA_URL=https://grafana.example.com
# Only when the SPA is hosted cross-origin (not needed behind a same-origin proxy).
# KNEO_DASH_CORS_ORIGINS=["https://dash.example.com"]
