{
  "name": "Nightly sync",
  "nodes": [
    {
      "id": "1",
      "name": "Every night",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "2",
      "name": "Fetch records",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "parameters": {
        "url": "https://api.example.com/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer sk-live-NOT-A-REAL-KEY" }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Vendor widget",
      "type": "n8n-nodes-vendor.widget",
      "typeVersion": 1,
      "position": [420, 0],
      "parameters": {}
    }
  ],
  "connections": {
    "Every night": { "main": [[{ "node": "Fetch records" }]] },
    "Fetch records": { "main": [[{ "node": "Vendor widget" }]] }
  }
}
